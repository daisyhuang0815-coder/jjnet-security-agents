# JJNET 資安多 Agent 系統環境變數範本
# 複製此檔案為 .env 並填入實際 API Key

# 選擇 AI 模型供應商：unieai 或 gemini
AI_PROVIDER=unieai

# 1. UnieAI (OpenAI-Compatible) 設定
UNIEAI_BASE_URL=https://api.unieai.com/v1
UNIEAI_MODEL=gemma-4-E4B-it
UNIEAI_API_KEY=

# 2. Google Gemini 原生 API 設定 (切換備用)
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=
