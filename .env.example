# ============================================================================
# JJNET MSSP Sovereign AI Agent 設定檔
# ============================================================================

# AI 提供者：unieai (對接 UnieAI Studio 專屬推理端點) | local_sovereign (100% 地端離線) | ollama | gemini
AI_PROVIDER=unieai

# 核心模型規格：Gemma 4 31B (gemma-4-31B-it)
UNIEAI_BASE_URL=https://api.unieai.com/v1
UNIEAI_MODEL=gemma-4-31B-it
UNIEAI_API_KEY=sk-your-unieai-api-key-here

# 本地 Ollama / vLLM 執行端點 (選用)
LOCAL_LLM_URL=http://localhost:11434/v1

# Google Gemini API 設定 (選用備用)
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=
