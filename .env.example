# ============================================================================
# JJNET MSSP Sovereign AI Agent 設定檔
# ============================================================================

# AI 提供者：local_sovereign (預設 100% 地端離線) | unieai | ollama | gemini
AI_PROVIDER=local_sovereign

# 核心模型規格：Gemma 4 28B
UNIEAI_BASE_URL=https://api.unieai.com/v1
UNIEAI_MODEL=gemma-4-28b-it
UNIEAI_API_KEY=

# 本地 Ollama / vLLM 執行端點 (選用)
LOCAL_LLM_URL=http://localhost:11434/v1

# Google Gemini API 設定 (選用備用)
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=
